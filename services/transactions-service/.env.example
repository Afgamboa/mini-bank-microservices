# Connection to transactions-db (see ../../docker-compose.yml)
DATABASE_URL="postgresql://transactions_user:change_me@localhost:5434/transactions?schema=public"

# Must match auth-service's JWT_SECRET so tokens issued by Auth are valid here too
JWT_SECRET=change_me_local_dev_secret

PORT=3003

ACCOUNTS_SERVICE_URL=http://localhost:3002
INTERNAL_API_KEY=change_me_internal_key

# Broker where TransferCompleted / TransferFailed are published
RABBITMQ_URL=amqp://guest:guest@localhost:5672
