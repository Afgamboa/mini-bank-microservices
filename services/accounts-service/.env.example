# Connection to accounts-db (see ../../docker-compose.yml and ../../.env.example)
DATABASE_URL="postgresql://accounts_user:change_me@localhost:5433/accounts?schema=public"

# Must match auth-service's JWT_SECRET so tokens issued by Auth are valid here too
JWT_SECRET=change_me_local_dev_secret

PORT=3002

# Shared secret for service-to-service calls (header x-internal-api-key); must equal transactions-service's
INTERNAL_API_KEY=change_me_internal_key

# Broker where AccountOpened is published (see ../../docker-compose.yml)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
